  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Flow",
      "items": [
        "User submits job description via Next.js frontend",
        "Express API authenticates request with JWT",
        "Pipeline orchestrates 11-stage extraction process",
        "Final kit stored in MongoDB with validation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Extraction Pipeline",
      "items": [
        "Stage 1: Crawl company website (scored BFS)",
        "Stage 2: Research interview process (DuckDuckGo/SerpApi)",
        "Stages 3-4: Extract requirements + generate brief (LLM)",
        "Stages 5-6: Generate questions + flashcards (LLM)",
        "Stage 7-8: Coverage check + gap fill (deterministic + LLM)",
        "Stages 9-11: Build schedule + validate + persist"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "JWT authentication (HS256, 24h expiry)",
        "SSRF protection on crawler (blocks RFC 1918)",
        "Input sanitization (XSS prevention)",
        "Robots.txt compliance",
        "Rate limiting on external requests"
      ]
    },
    {
      "dot": "violet",
      "title": "Real-time Updates",
      "items": [
        "Server-Sent Events stream pipeline progress",
        "11 named stages emitted as events",
        "Frontend displays live progress tracker",
        "Graceful error handling per stage"
      ]
    },
    {
      "dot": "amber",
      "title": "External Dependencies",
      "items": [
        "LLM: Google Gemini 1.5 Flash or Groq Llama 3.1",
        "Search: DuckDuckGo (free) or SerpApi (100/mo)",
        "Database: MongoDB Atlas (free tier)",
        "Hosting: Vercel (serverless functions + edge)"
      ]
    }
